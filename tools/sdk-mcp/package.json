{
  "name": "ciqkit-sdk-mcp",
  "version": "0.1.0",
  "description": "MCP server answering Connect IQ SDK API questions from the SDK documentation installed on your own machine, plus a curated Monkey C gotchas database.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JohannesHoh/ciqkit.git",
    "directory": "tools/sdk-mcp"
  },
  "homepage": "https://github.com/JohannesHoh/ciqkit/blob/main/docs/sdk-mcp.md",
  "bugs": {
    "url": "https://github.com/JohannesHoh/ciqkit/issues"
  },
  "keywords": [
    "garmin",
    "connect-iq",
    "monkey-c",
    "mcp",
    "model-context-protocol"
  ],
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "ciqkit-sdk-mcp": "dist/index.js",
    "ciqkit-sdk-parse": "dist/parse-sdk.js"
  },
  "files": [
    "dist",
    "data/gotchas.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "parse-sdk": "tsx src/parse-sdk.ts",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepublishOnly": "npm run clean && npm run build",
    "bundle": "esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/ciqkit-sdk-mcp.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "cheerio": "^1.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "esbuild": "^0.28.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
