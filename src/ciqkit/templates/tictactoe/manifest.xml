<?xml version="1.0" encoding="UTF-8"?>
<!--
  Change the application id below when you fork this example. Two apps with the
  same id overwrite each other on a watch and in the Connect IQ store.
  Generate a new one with: python3 -c "import uuid; print(uuid.uuid4())"
-->
<iq:manifest version="3" xmlns:iq="http://www.garmin.com/xml/connectiq">
    <iq:application
        id="{{UUID}}"
        type="watch-app"
        name="@Strings.AppName"
        entry="TicTacToeApp"
        launcherIcon="@Drawables.LauncherIcon"
        minApiLevel="4.0.0">
        <iq:products>
{{PRODUCTS}}
        </iq:products>
        <iq:permissions/>
        <iq:languages>
            <iq:language>eng</iq:language>
        </iq:languages>
        <iq:barrels/>
    </iq:application>
</iq:manifest>
